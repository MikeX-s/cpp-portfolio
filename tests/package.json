{
  "name": "wasm-portfolio-tests",
  "version": "1.0.0",
  "description": "Playwright E2E + deployment tests for the WASM Portfolio game",
  "type": "module",
  "scripts": {
    "test":         "playwright test --config=playwright.config.js",
    "test:e2e":     "playwright test --config=playwright.config.js --project=chromium specs/e2e.spec.js",
    "test:deploy":  "playwright test --config=playwright.config.js --project=chromium specs/deployment.spec.js",
    "test:headed":  "playwright test --config=playwright.config.js --headed",
    "report":       "playwright show-report report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "serve": "^14.2.3"
  }
}
